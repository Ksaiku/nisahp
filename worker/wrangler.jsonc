{
  "name": "nisa-rag-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "nisa-fsa-current" }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "PRIMARY_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8",
    "DOC_VERSION": "2026-09-05",
    "SCORE_THRESHOLD_MIN": 0.62,
    "SCORE_THRESHOLD_ANSWER": 0.67,
    "ALLOWED_ORIGIN": "https://ksaiku.github.io",
    "TOP_K": 15
  }
}
